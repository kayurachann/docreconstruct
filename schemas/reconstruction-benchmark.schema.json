{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kayurachann/docreconstruct/schemas/reconstruction-benchmark.schema.json",
  "title": "Three-source reconstruction benchmark manifest",
  "description": "End-to-end cases containing original layout, reviewed Markdown, and positioned JSON evidence. Candidates are generated by the benchmark runner and cannot be supplied by the manifest.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": [
          "job_options",
          "reconstruction"
        ]
      }
    }
  ],
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "seed": {
      "type": "integer",
      "default": 0
    },
    "configuration": {
      "type": "object"
    },
    "job_options": {
      "$ref": "#/$defs/jobOptions"
    },
    "reconstruction": {
      "$ref": "#/$defs/jobOptions",
      "deprecated": true,
      "description": "Backward-compatible alias for job_options."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stringOrArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      ]
    },
    "jobOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict_evidence": {
          "type": "boolean",
          "default": true
        },
        "allow_remote_assets": {
          "type": "boolean",
          "default": false,
          "description": "A case request only. Remote assets are enabled only when the runtime/CLI also opts in."
        },
        "render_backend": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "native",
            "auto",
            "libreoffice",
            null
          ],
          "description": "May de-escalate a runtime-rendered benchmark to native; cannot enable or replace a backend not selected by the runtime."
        },
        "minimum_visual_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "save_render_artifacts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "evidenceItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "provider": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "providerHints": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonEmptyString"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/stringOrArray"
        },
        "languages": {
          "$ref": "#/$defs/stringOrArray"
        },
        "script": {
          "$ref": "#/$defs/stringOrArray"
        },
        "scripts": {
          "$ref": "#/$defs/stringOrArray"
        },
        "document_type": {
          "$ref": "#/$defs/stringOrArray"
        },
        "document_types": {
          "$ref": "#/$defs/stringOrArray"
        },
        "degradation": {
          "$ref": "#/$defs/stringOrArray"
        },
        "degradations": {
          "$ref": "#/$defs/stringOrArray"
        },
        "content_kind": {
          "$ref": "#/$defs/stringOrArray"
        },
        "content_kinds": {
          "$ref": "#/$defs/stringOrArray"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "id",
              "case_id"
            ]
          }
        }
      ],
      "required": [
        "original_layout",
        "reviewed_markdown",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "case_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "original_layout": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewed_markdown": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "evidence_provider_hints": {
          "$ref": "#/$defs/providerHints"
        },
        "job_options": {
          "$ref": "#/$defs/jobOptions"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
